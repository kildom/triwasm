# VM Registers
TMP0 = 0
PC = 4
ASP = 8
TMP1 = 12
TMP2 = 16
AMB0 = 20
AMB1 = 24
SPL = 28
SPH = 32
ASPL = 36
ASPH = 40
registers_end = 44

<% if (conf.separateMemory) { %>
    .base 0x80000000
    BR main_entry
    .pma 5
    BR fault_handler
    .pma 16
<% } else { %>
    .base 0
    .data32 0 # TMP0
    .data32 0 # PC
    .data32 <%= conf.regs.asp %> # ASP
    .data32 0 # TMP1
    .data32 0 # TMP2
    .data32 <%= conf.regs.amb0 %> # AMB0
    .data32 0 # AMB1
    .data32 0 # SPL
    .data32 0xFFFFFFFF # SPH
    .data32 0 # ASPL
    .data32 0 # ASPH
    BR main_entry
    .pma registers_end + 5
    BR fault_handler
    .pma registers_end + 16
<% } %>

.place export_slots

TRIVM_FAULT_WASM_TABLE_INDEX = 17
TRIVM_HOST_CALLBACK_IMPORT_ID = -1

.annotation license:triwasmlib
// TODO: Add to triwasm and triasm tools `--allow-licenses` argument that allows inclusion
// of the code covered by specific license. `triwasmlib` is always allowed. Special value `all`
// allows all licenses. Example: --allow-licenses=Berkeley-SoftFloat
// `--show-licenses` will show list of declared and used licenses.

// Prologue

.trampoline exception

// TODO: simple entry if there is no exports and no control entry
//       there is no need for export table, because only startup is used
entry:
PUSH program_memory_base
WRITE PMB
PUSH return_to_host
READ TMP0
MUL (export_table_end - export_table_begin) / export_table_count
READ [POP] + export_table_begin + program_memory_base
AND (((1 << ((export_table_end - export_table_begin) / export_table_count * 8 - 1)) - 1) << 1) + 1
WRITE PC
return_to_host:
EXT -1

startup:
// save return address
WRITE TMP0
// save old stack pointer
READ SP
WRITE TMP1
// set new stack pointer
PUSH trivm_initial_stack_pointer  // TODO: if wasm module does not have memory (or it is unused), default stack pointer should be used
WRITE SP
// clear old stack in a safe way (will not corrupt new stack even if overlapping with old one)
READ TMP1
PUSH 0
WRITE [POP] - 4
READ TMP1
PUSH 0
WRITE [POP] - 8
// setup stack boundaries if needed
.begin
trivm_stack_boundary_low_set:
PUSH trivm_stack_boundary_low
WRITE SBL
.end
.begin
trivm_stack_boundary_high_set:
PUSH trivm_stack_boundary_high
WRITE SBH
.end
// setup auxiliary memory base
PUSH trivm_auxiliary_memory_base // TODO: if wasm module does not have memory, skip auxiliary memory base setup 
WRITE AMB
// setup auxiliary stack pointer
.begin
trivm_auxiliary_stack_pointer_set:
PUSH trivm_auxiliary_stack_pointer
WRITE ASP
.end
.begin
trivm_auxiliary_stack_boundary_low_set:
PUSH trivm_auxiliary_stack_boundary_low
WRITE ASBL
.end
.begin
trivm_auxiliary_stack_boundary_high_set:
PUSH trivm_auxiliary_stack_boundary_high
WRITE ASBH
.end


//...

/*

Memory organization:
- exported globals are just after the registers (including non-mutable)
- mutable globals are after exported globals
- non-mutable globals are at the end of program memory
- imported globals are read by call to host function index -1 and written by index -2
- detected stack global is in ASP register

*/

# Configurations:
# tableLengthSize - size (in bytes) of the table length field, 0, 2, or 4
# tableElementSize - size (in bytes) of the table element, 2 or 4
# hostCallbacks - are the host callbacks enabled

# Table structure:
#       u32 table_pointer     Anywhere in the memory, if exported/imported then in import-export slot
#             ^       |       Label: $_tableN_ptr
#             |       +---+   Can be removed if:
#             |           |    * not movable table
#             |           |    * not exported/imported
#             |           |
#   u32/16 return_pointer |   Points back to the table pointer, needed for updating table pointers
#                         |   during table grow.
#                         |   Can be removed if:
#                         |    * not movable table
#                         |   Can be u16 (globally) if:
#            +------------+    * all tables are not exported/imported
#            |                 * small memory model (<= 64K)
#            V
#  u32/16 length              Number of items in the table.
#                             Label: $_tableN_start
#                             Can be removed (globally) if:
#                              * all tables are not exported/imported
#                              * all tables are not growable
#                              * table index faults are disabled
#                             Can be u16 (globally) if:
#                              * all tables are not exported/imported
#                              * small memory model (<= 64K)
#
#  u32/16 callbacks[]         Array of callbacks.
#                             Highest bit indicates host callback if host callbacks are enabled.
#                             Can be u16 (globally) if:
#                              * all tables are not exported/imported
#                              * all tables are funcref
#                              * small program model (<= 32K)
#                              * host callbacks are disabled

<% for (let tableIndex = module.tables.length - 1; tableIndex >= 0 ; tableIndex--) { %>
    <% let table = module.tables[tableIndex]; %>
    # Call function from table <%= tableIndex %>
    # @stack  function_params..., entry_index, return_address
    #     =>  function_results...
    .begin discardable
        __call_indirect_table<%= tableIndex %>:
        <% if (table.isMovable) { %>
            NEG -__table<%= tableIndex %>_ptr
            READ32 [POP] # Read table pointer
        <% } else { %>
            NEG -__table<%= tableIndex %>_start
        <% } %>
        <% if (tableIndex == 0) { %>
            # Fall into __call_indirect_common
            .ref __call_indirect_common
        <% } else { %>
            BR __call_indirect_common
        <% } %>
    .end
<% } %>

# Call function from specific table
# @stack  function_params..., index, return_address, table_start
#     =>  function_results...
# @param  table_start
.begin discardable
__call_indirect_common:
    .local invalid_index
    .local host_callback
    <% if (conf.tableLengthSize > 0 && conf.faults.wasmTableIndex) { %>
        READ32 [SP]         # ..., index, return_address, table_start, table_start
        <% if (conf.tableLengthSize == 2) { %>
            READ16 [POP]
        <% } else { %>
            READ32 [POP]
        <% } %>             # ..., index, return_address, table_start, table_length
        READ32 [SP] - 12    # ..., table_length, index
        UGT                 # ..., index, return_address, table_start, (table_length > index)
        BRF invalid_index
    <% } %>                 # ..., index, return_address, table_start
    READ32 [SP] - 8         # ..., index, return_address, table_start, index
    MUL <%= conf.tableElementSize %> #               ..., table_start, offset
    <% if (conf.tableLengthSize > 0) { %>
        ADD <%= conf.tableLengthSize %>
    <% } %>                 #                        ..., table_start, offset
    ADD                     #                        ..., item_ptr
    <% if (conf.hostCallbacks) { %>
        READ32 [POP]        # ..., callback
        READ32 [SP]         # ..., callback, callback
        AND 0x7FFFFFFF      # ..., callback, callback_address
        READ32 [SP] - 4     # ..., callback, callback_address, callback
        READ32 [SP] - 4     # ..., callback, callback_address, callback, callback_address
        XOR                 # ..., callback, callback_address, host_callback_flag
        BRT host_callback   # ..., callback, callback_address
        WRITE32 [SP]        # ..., callback_address
    <% } else { %>
        <% if (conf.tableElementSize == 2) { %>
            READ16 [POP]
        <% } else { %>
            READ32 [POP]
        <% } %>
    <% } %>                 # params..., index, return_address, callback_address
    <% if (conf.ext.unwind) { %>
        UNWIND 48           # jump to callback_address, keep 1, skip 1
    <% } else { %>
        NEG -32             # keep 2, skip 1
        CALL __triwasmlib_unwind # params..., return_address, callback_address
        WRITE32 PC
    <% } %>

    .begin discardable
    invalid_index:                          # ..., index, return_address, table_start
        READ32 [SP] - 4                     # ..., index, return_address, table_start, index
        NEG -TRIVM_FAULT_WASM_TABLE_INDEX   # ..., index, return_address, table_start, index, fault_type
        BR __trigger_fault_with_two_codes
    .end

    .begin discardable
    host_callback:      # params..., index, return_address, callback, callback_address
        WRITE32 TMP0    # params..., index, return_address, callback
        WRITE32 TMP1    # params..., index, return_address
        WRITE32 [SP]    # params..., return_address
        WRITE32 TMP1    # params...
        HOST TRIVM_HOST_CALLBACK_IMPORT_ID
    .end
.end

.begin discardable
    __trigger_fault:
    WRITE32 TMP0
    WRITE32 TMP2
    BR __exception_handler
.end

.begin discardable
    __trigger_fault_with_code:
    WRITE32 TMP0
    WRITE32 TMP1
    WRITE32 TMP2
    BR __exception_handler
.end

.begin discardable
    __trigger_fault_with_two_codes:
    WRITE32 TMP0
    WRITE32 TMP1
    WRITE32 wasm_TMP3
    WRITE32 TMP2
    BR __exception_handler
.end

.begin movable __triwasm_epilogue
    .begin discardable
    .annotation license:Berkeley-SoftFloat
    softfloat_approxRecip_1k0s_table:
    .data16 0xFFC4, 0xF0BE, 0xE363, 0xD76F, 0xCCAD, 0xC2F0, 0xBA16, 0xB201,
    .data16 0xAA97, 0xA3C6, 0x9D7A, 0x97A6, 0x923C, 0x8D32, 0x887E, 0x8417,
    .end
    .begin discardable
    .annotation license:Berkeley-SoftFloat
    softfloat_approxRecip_1k1s_table:
    .data16 0xF0F1, 0xD62C, 0xBFA1, 0xAC77, 0x9C0A, 0x8DDB, 0x8185, 0x76BA,
    .data16 0x6D3B, 0x64D4, 0x5D5C, 0x56B1, 0x50B6, 0x4B55, 0x4679, 0x4211,
    .end
.end
