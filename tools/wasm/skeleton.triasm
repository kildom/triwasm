<%
/*!
 * Copyright (c) 2023 Dominik Kilian <kontakt@dominik.cc>
 * SPDX-License-Identifier: 0BSD
 */

/* eslint-disable max-len */
/* eslint-disable quotes */

import { WasmModule } from './wasmModule';
import { WasmConf } from './args';
import { CodeOutput } from './codeOutput';
import { FuncGenerator } from './genFunction';
import { MemoryGenerator } from './genMemory';
import { GlobalsGenerator } from './genGlobal';
import { TablesGenerator } from './genTable';

export function skeleton(
    module: WasmModule,
    funcGen: FuncGenerator,
    memoryGen: MemoryGenerator,
    globalsGen: GlobalsGenerator,
    tablesGen: TablesGenerator,
    conf: WasmConf,
    output: CodeOutput
) {
    function print(s?: any) {
        if (s === undefined) {
            // skip
        } else if (typeof s === 'object') {
            output.outputRaw(s);
        } else if (typeof s === 'string') {
            output.outputPart(s);
        } else {
            output.outputPart(s.toString());
        }
    }

    memoryGen.generate();
    globalsGen.generate();
    tablesGen.generate();
%>

# Globals:
# $_program_memory_base - base address of program memory in virtual address space (0 for RAM program, 0x80000000 for ROM programs)
# $_vm_registers_end - end of triVM registers space

# ===========================================================
# ======================== CONSTANTS ========================
# ===========================================================

TRIWASM_FAULT_UNREACHABLE = 64
TRIWASM_FAULT_TABLE_INDEX = 65
TRIWASM_FAULT_NULL_CALL = 66
TRIWASM_FAULT_INVALID_EXPORT = 67

<% if (conf.vmConf.extensions.int64 || conf.vmConf.extensions.float64) { %>
    $_STACK_POP_MAX_BYTES = 8 + 8
<% } else if (conf.vmConf.extensions.mem64) { %>
    $_STACK_POP_MAX_BYTES = 4 + 8
<% } else { %>
    $_STACK_POP_MAX_BYTES = 4 + 4
<% } %> # TODOv1: Check all instructions if this conditions are true


# ===========================================================
# ======================= DATA MEMORY =======================
# ===========================================================

# Two memory model starts program memory at 0x80000000
$_program_memory_base = 0x80000000
.base $_program_memory_base

# ======================= VM Registers =======================

# Declaration
GPR0 = 0
GPR1 = 4
GSP = 8
SP = 12
PC = 16
MAB0 = 20
MAB1 = 24
MAB2 = 28
MAB3 = 32
GPR2 = 36
GPR3 = 40
SPL = 44
SPH = 48
GSPL = 52
GSPH = 56
.vma 60

$_initial_sp_value = MAB0

# Initialization
..skip 28 # PC, GPR0, GPR1, SP, GSP, MAB0, MAB1 - not needed or cannot be touched
..part 4
.data32 $_program_memory_globals # MAB2
..end
..skip 28 # MAB3, GPR2, GPR3, SPL, SPH, GSPL, GSPH - not needed or initialized by stack initialization

# ======================= External globals =======================

$_data_memory_globals = vma()

# TODOv2: Put here imported and exported globals.

# ======================= Globals in data memory =======================

<%= globalsGen.dataMemory.getOutput(true) %>

# ======================= Tables in data memory =======================

<%= tablesGen.dataMemory.getOutput(true) %>

# ======================= VM stack =======================

# Start of triVM stack free space
$_vm_stack_start_without_align = vma()
.align 4
$_vm_stack_start = vma()

# Finalize memory initialization table pseudo-directives before stack begin
..skip 3, $_vm_stack_start - $_vm_stack_start_without_align
..finalize

# ======================= WASM data =======================

.begin movable $_memory_init_table
<%= memoryGen.initTable.getOutput(true) %>
.data8 254 # Memory initialization end marker
.end

<%/*
Special pseudo-directives for the memory initialization table:
..skip N - skip N bytes
..skip N, EXP - skip EXP bytes, maximum value of expression is N
..part N - start unbreakable part of the table with maximum size of N bytes
..part discardable N - start unbreakable discardable part of the table with maximum size of N bytes
..end - end part
..finalize - finalize memory initialization table pseudo-directives and set $_mem_init_final_skip
             to remaining number of skip bytes for the next block.
*/%>

# ===========================================================
# ===================== PROGRAM MEMORY ======================
# ===========================================================

.pma 0

# ===================== MAIN AND FAULT ENTRIES ======================

BR $_main_entry
.pma 3
<% if (conf.faults.anyVmFault) { %>
    # Fault is next instruction, so no need to do BR
    .ref $_fault_handler
<% } %>

# ===================== FAULT HANDLER ======================

.begin discardable
$_fault_handler:
# Reinitialize VM stack if fault code is 0 or 1 (stack overflow/underflow)
READ32 GPR0
UGT 1
.local skip_sp_restore
BRT skip_sp_restore
CALL $_initialize_stack
skip_sp_restore:
# Put fault data into the stack, to call handler as usual function
READ32 GPR0
READ32 GPR1
READ32 GPR3
READ32 GPR2
# Put return address to allow return when possible
READ32 GPR2
BR $_trivm_fault_handler
.end

# Make default $_trivm_fault_handler as a weak reference
.begin discardable
$_trivm_default_fault_handler:
HOST -0x80000000 # Special exit code to host indicating fault unhandled by guest.
BR $_trivm_fault_handler_weak
.end
.begin movable $_weak_symbols
.begin discardable
$_trivm_fault_handler = $_trivm_default_fault_handler
.end
.end

# ===================== MAIN ENTRY HANDLER ======================

$_main_entry:
.begin
READ32 SP
EQ $_initial_sp_value
BRF skip_startup

# Startup code
CALL $_initialize_stack

# Memory initialization table copy
.begin
READ32 MAB0
NEG -$_memory_init_table_start
.local copy_next_block
copy_next_block:
# ..., dst, src
# Read block gap bytes.
READ32 [SP]
READ8U [POP]
READ32 [SP]
EQ 255
.local skip_32_bits
BRF skip_32_bits
    # ..., dst, src-1, 255
    WRITE32 GPR0
    READ32 [SP]
    UREAD32 [POP] + 1
    # ..., dst, src-5, gap_bytes
    READ32 [SP] - 4
    ADD 4
    WRITE32 [SP] - 4
    # ..., dst, src-1, gap_bytes
skip_32_bits:
READ32 [SP]
EQ 254
.local exit_mem_init
BRT exit_mem_init
skip_32_bits:
# ..., dst, src-1, gap_bytes
# Skip "gap_bytes" in dst.
READ32 [SP] - 8
ADD
WRITE32 [SP] - 4
# ..., dst, src-1
READ32 [SP]
READ8U [POP] + 1
READ32 [SP] - 4
ADD 2
WRITE32 [SP] - 4
# ..., dst, src, copy_bytes
CALL $_mem_copy_and_update
# ..., dst, src
BR copy_next_block
exit_mem_init:
WRITE32 GPR0
WRITE32 GPR0
.end

# Globals dynamic initialization
<%= globalsGen.dynamicInit.getOutput(true) %>

# Calling exported function

skip_startup:
NEG -$_normal_return_to_host
<% if (conf.faults.invalidExport) { %>
    READ32 GPR0
    ULT <%= module.exportFunctionTable.length %>
    .local skip_invalid_export
    BRT skip_invalid_export
    $_trigger_invalid_export_fault:
    NEG -TRIWASM_FAULT_INVALID_EXPORT
    READ32 GPR0
    BR $_trigger_fault_with_code
    skip_invalid_export:
<% } else { %>
    .begin discardable
    $_trigger_invalid_export_fault = $_normal_return_to_host
    .end
<% } %>
READ32 GPR0
<% if (conf.smallProgramModel) { %>
    MUL 2
    READ16U [POP] + $_export_table + $_program_memory_base
<% } else { %>
    MUL 4
    READ32 [POP] + $_export_table + $_program_memory_base
<% } %>
WRITE32 PC
.end

.begin
$_initialize_stack:
# Initialize VM and guest stack pointers. This have to be done in right
# order to avoid unintentionally triggering any stack fault.

# Keep return address since it will not be available after SP change.
WRITE32 MAB3

# Disable stack overflow when shared stack is used.
<% if (conf.faults.stackOverflow || conf.faults.guestStackOverflow) { %>
    READ32 AMB0
    WRITE32 GSPL
<% } %>

# Disable stack underflow.
<% if (conf.faults.stackUnderflow) { %>
    READ32 AMB0
    WRITE32 SPL
<% } %>

# Disable stack overflow.
<% if (conf.faults.stackOverflow) { %>
    NEG -(0xFFFFFFFF)
    WRITE32 SPH
<% } %>

# Set stack pointer.
NEG -($_vm_stack_start + $_STACK_POP_MAX_BYTES - 4)
WRITE32 SP

# Set guest stack pointer.
<% if (conf.faults.guestStackUnderflow || conf.faults.guestStackOverflow) { %>
    <% if (conf.faults.guestStackUnderflow) { %>
        NEG -(0xFFFFFFFF)
        WRITE32 GSPH
    <% } %>
    NEG -(0) # TODO: set guest stack initial value
    WRITE32 GSP
<% } %>

# Setup guest stack pointer highest value.
<% if (conf.faults.guestStackUnderflow) { %>
    NEG -(0xFFFFFFFF) # TODO: set limiting value
    WRITE32 GSPH
<% } %>

# Setup guest stack pointer lowest value.
<% if (conf.faults.guestStackOverflow) { %>
    NEG -(0) # TODO: set limiting value
    WRITE32 GSPL
<% } %>

# Setup VM stack pointer highest value.
<% if (conf.faults.guestStackUnderflow) { %>
    NEG -(0xFFFFFFFF) # TODO: set limiting value
    WRITE32 SPH
<% } %>

# Setup VM stack pointer lowest value.
<% if (conf.faults.guestStackOverflow) { %>
    READ32 SP
    WRITE32 SPL
<% } %>

# Restore MAB1/3 and return
READ32 MAB3
NEG -(<%= memoryGen.wasmBase %>)
WRITE32 MAB1
NEG -($_data_memory_globals)
WRITE32 MAB3
WRITE32 PC
.end

# Export table

<% if (conf.smallProgramModel) { %>
    .align 2
    $_export_table:
    .data16 <%= module.exportFunctionTable.map(func => func ? func.name : '$_trigger_invalid_export_fault').join(', ') %>
<% } else { %>
    .align 4
    $_export_table:
    .data32 <%= module.exportFunctionTable.map(func => func ? func.name : '$_trigger_invalid_export_fault').join(', ') %>
<% } %>

# ===================== UTILITY FUNCTIONS ======================

.begin
$_mem_copy_and_update:
# ..., dst, src, copy_bytes, ret
READ32 [SP] - 4
.local done
BRF done
READ32 [SP] - 4
SUB 1
WRITE32 [SP] - 4
READ32 [SP] - 8
READ32 [SP]
ADD 1
WRITE32 [SP] - 12
# ..., dst, src+1, copy_bytes-1, ret, src
READ8U [POP]
# ..., dst, src+1, copy_bytes-1, ret, value
READ32 [SP] - 16
READ32 [SP]
ADD 1
WRITE32 [SP] - 20
# ..., dst+1, src+1, copy_bytes-1, ret, value, dst
WRITE8 [POP]
# ..., dst+1, src+1, copy_bytes-1, ret
BR $_mem_copy_and_update
done:
# ..., dst+copy_bytes, src+copy_bytes, 0, ret
WRITE32 [SP]
# ..., dst+copy_bytes, src+copy_bytes, ret
WRITE32 PC
.end

.begin discardable
$_normal_return_to_host:
HOST -1
.end

.begin discardable
$_trigger_null_call:
NEG -TRIWASM_FAULT_NULL_CALL
.ref $_trigger_fault # Fall through to $_trigger_fault
.end

.begin discardable
$_trigger_fault:
WRITE32 GPR0
.ref $_trigger_fault_tail # Fall through to $_trigger_fault_tail
.end

.begin discardable
$_trigger_fault_tail:
WRITE32 GPR2
BR $_fault_handler
.end

.begin discardable
$_trigger_fault_with_code:
WRITE32 GPR0
WRITE32 GPR1
BR $_trigger_fault_tail
.end

.begin discardable
$_trigger_fault_with_two_codes:
WRITE32 GPR0
WRITE32 GPR1
WRITE32 GPR3
BR $_trigger_fault_tail
.end

# ===================== FUNCTIONS BODY ======================

<%= funcGen.generate(true) %>

# ===================== MEMORY INIT TABLE ======================

$_memory_init_table_start = vma()
.place $_memory_init_table

# Globals in program memory
$_program_memory_globals = vma()
<%= globalsGen.programMemory.getOutput(true) %>

# Tables in program memory
<%= tablesGen.programMemory.getOutput(true) %>

#tag WEAKSYMBOLS 

.place $_weak_symbols

<% } %>
