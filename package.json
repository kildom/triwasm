{
  "private": true,
  "name": "trivm-sdk",
  "version": "0.0.1",
  "description": "SDK for triVM",
  "scripts": {
    "build-triasm": "tsc -p tools/asm/triasm.tsconfig.json",
    "postbuild-triasm": "node build/postbuild.js starters",
    "build-triwasm": "tsc -p tools/wasm/triwasm.tsconfig.json",
    "postbuild-triwasm": "node build/postbuild.js starters",
    "build-tricc": "tsc -p tools/cc/tricc.tsconfig.json",
    "postbuild-tricc": "node build/postbuild.js starters",
    "build-triconf": "tsc -p tools/conf/triconf.tsconfig.json",
    "postbuild-triconf": "node build/postbuild.js starters",
    "build-static": "node build/postbuild.js copystatic licenses",
    "build": "concurrently -c white,red,magenta,yellow,blue npm:build-static npm:build-triasm npm:build-triwasm npm:build-tricc npm:build-triconf",
    "build-clean": "RmDiR /S /Q dist || rm -Rf dist",
    "rebuild": "npm run build-clean && npm run build",
    "build-tests": "tsc -p test/asm/vectors.tsconfig.json",
    "run-tests": "node --enable-source-maps test/output/asm/vectors.js"
  },
  "author": "Dominik Kilian <kontakt@dominik.cc>",
  "license": "GPL-3.0",
  "devDependencies": {
    "concurrently": "^7.6.0",
    "extract-zip": "^2.0.1",
    "ncp": "^2.0.0",
    "ts-node": "^10.9.1",
    "typedoc": "^0.23.20",
    "typescript": "^4.7.3",
    "xml2js": "^0.4.23"
  }
}
