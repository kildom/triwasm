{
  "private": true,
  "name": "trivm-sdk",
  "version": "0.0.1",
  "description": "SDK for triVM",
  "scripts": {
    "build-triasm": "npx tsc -p build/triasm.tsconfig.json",
    "postbuild-triasm": "node build/postbuild.js starters",
    "build-triwasm": "npx tsc -p build/triwasm.tsconfig.json",
    "postbuild-triwasm": "node build/postbuild.js starters",
    "build-tricc": "npx tsc -p build/tricc.tsconfig.json",
    "postbuild-tricc": "node build/postbuild.js starters",
    "build-triconf": "npx tsc -p build/triconf.tsconfig.json",
    "postbuild-triconf": "node build/postbuild.js starters",
    "build-static": "node build/postbuild.js copystatic licenses",
    "build": "npm run build-static && npm run build-triasm && npm run build-triwasm && npm run build-tricc && npm run build-triconf",
    "build-clean": "RmDiR /S /Q dist || rm -Rf dist",
    "rebuild": "npm run build-clean && npm run build"
  },
  "author": "Dominik Kilian <kontakt@dominik.cc>",
  "license": "GPL-3.0",
  "devDependencies": {
    "extract-zip": "^2.0.1",
    "ncp": "^2.0.0",
    "ts-node": "^10.9.1",
    "typedoc": "^0.23.20",
    "typescript": "^4.7.3",
    "xml2js": "^0.4.23"
  }
}
