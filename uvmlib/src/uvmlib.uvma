
.function REDUCE8
REDUCE8:
.locals ret, arg
WRITE TMP0
WRITE TMP1
READ TMP0
READ TMP1
AND 0x1F
READ TMP1
SHR 5
AND 0x07
BR REDUCE_INNER
.endfunc


.function REDUCE8_RET
REDUCE8_RET:
.locals arg, ret
WRITE TMP0
READ TMP0
AND 0x1F
READ TMP0
SHR 5
AND 0x07
BR REDUCE_INNER
.endfunc

.function REDUCE16
REDUCE16:
.locals ret, arg
WRITE TMP0
WRITE TMP1
READ TMP0
READ TMP1
AND 0x3FF
READ TMP1
SHR 10
AND 0x3F
BR REDUCE_INNER
.endfunc

.function REDUCE
REDUCE:
.locals ret, keep, skip,
WRITE TMP0
WRITE TMP1
WRITE TMP2
READ TMP0
READ TMP2
READ TMP1
BR REDUCE_INNER
.endfunc

.function REDUCE_INNER
REDUCE_INNER:
READ SP
.locals initial_sp, keep, skip, ret,
.endfunc

.func __uvmlib__and64
.locals ret, bh, bl, ah, al
WRITE __uvmlib__temp_addr
WRITE TMP0
WRITE TMP1
WRITE TMP2
READ TMP1
AND
READ TMP0
READ TMP2
AND
READ __uvmlib__temp_addr
RETURN
.endfunc