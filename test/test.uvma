

$w$my_function:
READ SP
SUB 12
WRITE SP
.stack_base $w$my_function$stack_base
PUSH 12
PUSH 34
READ [SP] + _$stack_length($w$my_function$stack_base) + 8
ADD 99
WRITE [SP] + _$stack_length($w$my_function$stack_base) + 4
PUSH 0x83
READ [SP] + ... // move return address to top of stack, so REDUCE will return directly to the caller
BR REDUCE8

