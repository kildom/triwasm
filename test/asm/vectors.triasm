## GROUP <%= Object.entries(ext).map(x => x[0] + '=' + (x[1] ? '1' : '0')).join(', ') %>
<%
simpleCoreInstr = {
    add: 0x02,
    sub: 0x03,
    mul: 0x04,
    and: 0x05,
    or: 0x06,
    xor: 0x07,
    udiv: 0x08,
    umod: 0x09,
    sdiv: 0x0A,
    smod: 0x0B,
    shl: 0x0C,
    exts: 0x0D,
    ushr: 0x0E,
    sshr: 0x0F,
    ult: 0x10,
    ugt: 0x11,
    slt: 0x12,
    sgt: 0x13,
    eq: 0x14,
    not: 0x15,
    neg: 0x16,
    host: 0x17,
};
%>

## GROUP Simple core instructions
<% for (let [name, code] of Object.entries(simpleCoreInstr)) { %>
## GROUP <%=name%>
<%=name%>              ## RESULT 1 5d<%=code%> 11
<%=name%> 0            ## RESULT 1 5d<%=code%> 10 | 8x00
<%=name%> 3            ## RESULT 1 5d<%=code%> 10 | 8x03
<%=name%> -128         ## RESULT 1 5d<%=code%> 10 | 8x80
<%=name%> 127          ## RESULT 1 5d<%=code%> 10 | 8x7F
<%=name%> 128          ## RESULT 1 5d<%=code%> 01 | 8x80 | 8x00
<%=name%> -129         ## RESULT 1 5d<%=code%> 01 | 8x7F | 8xFF
<%=name%> 32767        ## RESULT 1 5d<%=code%> 01 | 8xFF | 8x7F
<%=name%> -32768       ## RESULT 1 5d<%=code%> 01 | 8x00 | 8x80
<%=name%> 32768        ## RESULT 1 5d<%=code%> 00 | 8x00 | 8x80 | 8x00 | 8x00
<%=name%> -32769       ## RESULT 1 5d<%=code%> 00 | 8xFF | 8x7F | 8xFF | 8xFF
<%=name%> 2147483647   ## RESULT 1 5d<%=code%> 00 | 8xFF | 8xFF | 8xFF | 8x7F
<%=name%> -2147483648  ## RESULT 1 5d<%=code%> 00 | 8x00 | 8x00 | 8x00 | 8x80
<%=name%> 0x80000000   ## RESULT 1 5d<%=code%> 00 | 8x00 | 8x00 | 8x00 | 8x80
<%=name%> 0xFEDCBA98   ## RESULT 1 5d<%=code%> 00 | 8x98 | 8xBA | 8xDC | 8xFE
<%=name%> 0x01234567   ## RESULT 1 5d<%=code%> 00 | 8x67 | 8x45 | 8x23 | 8x01
<%=name%> 0, 0         ## RESULT ERROR
## GROUP_END
<% } %>
## GROUP zero-arg unwind
UNWIND                  ## RESULT 1 5x1A 11 <%= ext.unwind ? '' : ' ERROR ' %>
UNWIND 0                ## RESULT ERROR
## GROUP_END
## GROUP_END

<% { let code = ext.unwind ? 0x1A : ' ERROR '; %>
## GROUP Two-arguments unwind instruction
<%{
let values = [0, 3, 7, 8, 15, 0x10, 0x45, 0x7F, 0x80, 0xFF, 0x100, 0x1234, 0x7FFF, 0x8000, 0xFFFF, 0x10000];
for (let keep of values) for (let reduce of values) { %>
UNWIND <%=keep%>, <%=reduce%>
<% if (keep <= 0xF && reduce <= 0xF) { %>
    ## RESULT 1 5d<%=code%> 10 | 4d<%=keep%> 4d<%=reduce%>
<% } else if (keep <= 0xFF && reduce <= 0xFF) { %>
    ## RESULT 1 5d<%=code%> 01 | 8d<%=reduce%> | 8d<%=keep%>
<% } else if (keep <= 0xFFFF && reduce <= 0xFFFF) { %>
    ## RESULT 1 5d<%=code%> 00 | 8d<%=reduce&0xFF%> | 8d<%=reduce>>8%> | 8d<%=keep&0xFF%> | 8d<%=keep>>8%>
<% } else { %>
    ## RESULT ERROR
<% } %>
<% }} %>
## GROUP_END
<% } %>

## GROUP .BASE instruction

.BASE 0
.DATA32 vma()          ## RESULT 8x00 | 8x00 | 8x00 | 8x00

.BASE 0x80000000
.DATA32 vma()
offset:
.PMA 0
.DATA32 pma(), vma(), offset ## RESULT 8x00 | 8x00 | 8x00 | 8x00   |   8x00 | 8x00 | 8x00 | 8x80   |   8x04 | 8x00 | 8x00 | 8x00

.BASE my_base
.PMA 0
.DATA32 vma()
my_base = 0x10010000   ## RESULT 8x00 | 8x00 | 8x01 | 8x10

my_base = start_offset
.BASE my_base
start_offset:
.DATA32 vma()          ## RESULT ERROR

## GROUP_END

## GROUP Movable blocks

.BEGIN movable test1
.DATA8 1
.END
.DATA8 0
.PLACE test1        ## RESULT 8d0 | 8d1

.PLACE test2
.BEGIN movable test1
.DATA8 1
.END
.DATA8 2
.BEGIN movable test2
.DATA8 0
.PLACE test1
.END              ## RESULT 8d0 | 8d1 | 8d2

.BEGIN discardable
.DATA8 0
.PLACE test1
.END
.BEGIN discardable
.DATA8 2
.BEGIN movable test1
label:
.DATA8 1
.END
.END
.REF label      ## RESULT 8d0 | 8d1

.PLACE test2
.DATA8 2
.BEGIN movable test1
.DATA8 0
.BEGIN movable test2
.DATA8 1
.END
.END
.DATA8 2
.PLACE test1    ## RESULT 8d1 | 8d2 | 8d2 | 8d0

.BEGIN movable test1
.DATA8 0
.END            ## RESULT ERROR

.PLACE test1
.BEGIN movable test1
.DATA8 0
.END
.PLACE test1    ## RESULT ERROR

## GROUP_END

## GROUP Discardable blocks

.BEGIN discardable
.DATA8 1
.END
.DATA8 0            ## RESULT 0

.BEGIN discardable
label1:
.DATA8 label2
.END
.BEGIN discardable
label2:
.DATA8 label1
.END
.DATA8 0            ## RESULT 0

.BEGIN discardable
label1:
.DATA8 0
.END
.BEGIN discardable
.BEGIN
label2:
.DATA8 label1
.END
.DATA8 2
.END
.DATA8 label2            ## RESULT 0 | 0 | 8d2 | 1

.BEGIN discardable
label:
.DATA8 1
.END
.DATA8 label       ## RESULT 1 | 0

.BEGIN discardable
.DATA8 0
.BEGIN discardable
label:
.DATA8 1
.END
.END
.DATA8 label       ## RESULT 0 | 1 | 1

<% for (let i = 0; i < 2; i++) { %>
.BEGIN discardable
label0:
.DATA8 0
.END
.BEGIN discardable
label1:
.DATA8 1
.END
const_value = <%=i%>
.REF const_value ? label1 : label0    ## RESULT <%=i%>
<% } %>

.BEGIN discardable
label0:
.DATA8 0
.END
.BEGIN discardable
label1:
.DATA8 1
.END
non_const_value = label2
.REF non_const_value ? label1 : label0
label2:           ## RESULT 0 | 1

## GROUP_END

## GROUP Address directives

.DATA8 0x11
.PMA 5
.DATA8 0x22          
.VMA 7
.DATA8 0x33        ## RESULT 8x11 | 0 | 0 | 0 | 0 | 8x22 | 0 | 8x33

.DATA32 0x11
.PMA 3
.DATA8 0x22        ## RESULT ERROR

.DATA32 0x11
.VMA 3
.DATA8 0x22        ## RESULT ERROR

.BASE 0x1000
.PMA 0
.DATA8 0x11
.PMA 4
.DATA8 0x22
.VMA 0x1008
.DATA8 0x33        ## RESULT 8x11 | 0 *3 | 8x22 | 0 *3 | 8x33

ADD test1
.DATA8 0x22
.PMA 128
test1:
.DATA8 0x11        ## RESULT 1 5x02 01 | 8d128 | 0 | 8x22 | 0 *124 | 8x11

## GROUP_END

## GROUP Branch instructions

<% { let instr={ BR: 0x19, BRT: 0x00, BRF: 0x01, CALL: 0x18 }; %>
<% for (let [name, code] of Object.entries(instr)) { %>
## GROUP <%=name%>

<%=name%>           ## RESULT 1 5d<%=code%> 11

<%=name%> 0         ## RESULT 1 5d<%=code%> 10 | 8xFE

<%=name%> next
next:               ## RESULT 1 5d<%=code%> 10 | 8x00

<%=name%> next
.DATA8 1
.PMA 0x82
next:               ## RESULT 1 5d<%=code%> 01 | 8x7F | 0 | 1 | 0 *126

<%=name%> next
.DATA8 1
.PMA 0x81
next:               ## RESULT 1 5d<%=code%> 10 | 8x7F | 1 | 0 *126

<%=name%> next
.DATA8 1
.PMA 0x8004
next:               ## RESULT 1 5d<%=code%> 00 | 8xFF | 8x7F | 0 | 0 | 1 | 0 *32766

<%=name%> next
.DATA8 1
.PMA 0x8003
next:               ## RESULT 1 5d<%=code%> 00 | 8xFE | 8x7F | 0 | 0 | 1 | 0 *32765

<%=name%> next
.DATA8 1
.PMA 0x8002
next:               ## RESULT 1 5d<%=code%> 01 | 8xFF | 8x7F | 1 | 0 *32766

start:
.PMA 126
<%=name%> start     ## RESULT 0 *126 | 1 5d<%=code%> 10 | 8x80

start:
.PMA 127
<%=name%> start     ## RESULT 0 *127 | 1 5d<%=code%> 01 | 8x7E | 8xFF

start:
<%=name%> next
.DATA8 3
.FILL 124
<%=name%> start
.DATA8 3
next:               ## RESULT 1 5d<%=code%> 01 | 8x81 | 8x00 | 8x03 | 0 *124 | 1 5d<%=code%> 01 | 8x7D | 8xFF | 8x03

## GROUP_END
<% } %>
<% } %>

## GROUP_END

## GROUP .FILL

.FILL 1             ## RESULT 0
.FILL 2             ## RESULT 0 | 0
.DATA8 1
.FILL 5             ## RESULT 1 | 0 | 0 | 0 | 0 | 0
.DATA16 1
.FILL32 5, 0x88776655, 0x44332211
                    ## RESULT 1 | 0 | 8x55 | 8x66 | 8x77 | 8x88 | 8x11
.FILL8 10, 0x11, 0x22, 0x33
                    ## RESULT 8x11 | 8x22 | 8x33 | 8x11 | 8x22 | 8x33 | 8x11 | 8x22 | 8x33 | 8x11
.FILL -1            ## RESULT ERROR
.FILL               ## RESULT ERROR

## GROUP_END

## GROUP Read/Write stack

<% for (let [op, flag] of Object.entries({ READST: 0, WRITEST: 1 })) { %>

<%=op%>                ## RESULT ERROR
<%=op%> 0, 1           ## RESULT ERROR
<%=op%> 0              ## RESULT 0 1 <%=flag%> 5d0
<%=op%> 1 * 4          ## RESULT 0 1 <%=flag%> 5d1
<%=op%> 30 * 4         ## RESULT 0 1 <%=flag%> 5d30
<%=op%> 31 * 4         ## RESULT 0 1 <%=flag%> 5d31 | 7x00 0
<%=op%> 32 * 4         ## RESULT 0 1 <%=flag%> 5d31 | 7x01 0
<%=op%> 158 * 4        ## RESULT 0 1 <%=flag%> 5d31 | 7x7F 0
<%=op%> 159 * 4        ## RESULT 0 1 <%=flag%> 5d31 | 7x01 1 | 7x00 0
<%=op%> 16414 * 4      ## RESULT 0 1 <%=flag%> 5d31 | 7x7F 1 | 7x7F 0
<%=op%> 16415 * 4      ## RESULT 0 1 <%=flag%> 5d31 | 7x01 1 | 7x00 1 | 7x00 0
<%=op%> 16416 * 4      ## RESULT 0 1 <%=flag%> 5d31 | 7x01 1 | 7x00 1 | 7x01 0
<%=op%> 2097182 * 4    ## RESULT 0 1 <%=flag%> 5d31 | 7x7F 1 | 7x7F 1 | 7x7F 0
<%=op%> 2097183 * 4    ## RESULT 0 1 <%=flag%> 5d31 | 7x01 1 | 7x00 1 | 7x00 1 | 7x00 0
<%=op%> 268435486 * 4  ## RESULT 0 1 <%=flag%> 5d31 | 7x7F 1 | 7x7F 1 | 7x7F 1 | 7x7F 0
<%=op%> 268435487 * 4  ## RESULT 0 1 <%=flag%> 5d31 | 7x01 1 | 7x00 1 | 7x00 1 | 7x00 1 | 7x00 0
<%=op%> 0xFFFFFFFC     ## RESULT 0 1 <%=flag%> 5d31 | 7x03 1 | 7x7F 1 | 7x7F 1 | 7x7F 1 | 7x60 0
<%=op%> -4             ## RESULT 0 1 <%=flag%> 5d31 | 7x03 1 | 7x7F 1 | 7x7F 1 | 7x7F 1 | 7x60 0

<% } %>

## GROUP_END

## GROUP Read/Write one-byte instruction

<% for (let [name, flag] of Object.entries({'READ32': 0, 'WRITE32': 1})) { %>

    <%= name %>                  ## RESULT 0 0 <%= flag %> 3d0 0 0
    <%= name %> [mab0]           ## RESULT 0 0 <%= flag %> 3d0 0 0
    <%= name %> [mab1]           ## RESULT 0 0 <%= flag %> 3d0 1 0
    <%= name %> [pop]            ## RESULT 0 0 <%= flag %> 3d0 0 1
    <%= name %> [mab0] + [pop]   ## RESULT 0 0 <%= flag %> 3d0 0 1
    <%= name %> [mab1] + [pop]   ## RESULT 0 0 <%= flag %> 3d0 1 1

    <% for (let [mabName, mabFlag] of Object.entries({'': 0, '[mab0] +': 0, '[mab1] +': 1})) { %>
        <%= name %> <%= mabName %> 0                ## RESULT 0 0 <%= flag %> 3d0 <%= mabFlag %> 0
        <%= name %> <%= mabName %> 4                ## RESULT 0 0 <%= flag %> 3d1 <%= mabFlag %> 0
        <%= name %> <%= mabName %> 8                ## RESULT 0 0 <%= flag %> 3d2 <%= mabFlag %> 0
        <%= name %> <%= mabName %> 12               ## RESULT 0 0 <%= flag %> 3d3 <%= mabFlag %> 0
        <%= name %> <%= mabName %> 16               ## RESULT 0 0 <%= flag %> 3d4 <%= mabFlag %> 0
        <%= name %> <%= mabName %> 20               ## RESULT 0 0 <%= flag %> 3d5 <%= mabFlag %> 0
        <%= name %> <%= mabName %> [pop] + 0        ## RESULT 0 0 <%= flag %> 3d0 <%= mabFlag %> 1
        <%= name %> <%= mabName %> [pop] + 4        ## RESULT 0 0 <%= flag %> 3d1 <%= mabFlag %> 1
        <%= name %> <%= mabName %> [pop] + 8        ## RESULT 0 0 <%= flag %> 3d2 <%= mabFlag %> 1
        <%= name %> <%= mabName %> [pop] + 12       ## RESULT 0 0 <%= flag %> 3d3 <%= mabFlag %> 1
        <%= name %> <%= mabName %> [pop] + 16       ## RESULT 0 0 <%= flag %> 3d4 <%= mabFlag %> 1
        <%= name %> <%= mabName %> [pop] + 20       ## RESULT 0 0 <%= flag %> 3d5 <%= mabFlag %> 1
    <% } %>

<% } %>

## GROUP_END

## GROUP Read/Write aligned

<% for (let [mabName, mabFlags] of Object.entries({
    '': '2d0 0',
    '[mab0]': '2d0 0',
    '[mab1]': '2d1 0',
    '[mab2]': '2d2 0',
    '[mab3]': '2d3 0',
    '[pop]': '2d0 1',
    '[mab0] + [pop]': '2d0 1',
    '[mab1] + [pop]': '2d1 1',
    '[mab2] + [pop]': '2d2 1',
    '[mab3] + [pop]': '2d3 1',
})) { %>

    <% for (let [name, flag] of Object.entries({'READ': 0, 'WRITE': 1})) { %>

        <% if (ext.mem64) { %>
            <%=name%>32 <%= mabName %> + 4 * 6        ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> |          5d6 0 0 0
            <%=name%>32 <%= mabName %> + 4 * 31       ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> |         5d31 0 0 0
            <%=name%>32 <%= mabName %> + 4 * 32       ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 7d1 1 |  5d0 0 0 0
            <%=name%>32 <%= mabName %> + 4 * 33       ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 7d1 1 |  5d1 0 0 0
            <%=name%>32 <%= mabName %> + 0x7FFFFFFC   ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 0000111 1 | 1111111 1 | 1111111 1 | 1111111 1 | 11111 0 0 0
            <%=name%>32 <%= mabName %> + 0x80000000   ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 0001000 1 | 0000000 1 | 0000000 1 | 0000000 1 | 00000 0 0 0
            <%=name%>32 <%= mabName %> + 0xFFFF7FFC   ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 0001111 1 | 1111111 1 | 1111101 1 | 1111111 1 | 11111 0 0 0
            <%=name%>32 <%= mabName %> + 0xFFFF8000   ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 0001111 1 | 1111111 1 | 1111110 1 | 0000000 1 | 00000 0 0 0
            <%=name%>64 <%= mabName %>                ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> |          5d0 1 0 0
            <%=name%>64 <%= mabName %> + 4 * 6        ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> |          5d6 1 0 0
            <%=name%>64 <%= mabName %> + 4 * 31       ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> |         5d31 1 0 0
            <%=name%>64 <%= mabName %> + 4 * 32       ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 7d1 1 |  5d0 1 0 0
            <%=name%>64 <%= mabName %> + 4 * 33       ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 7d1 1 |  5d1 1 0 0
            <%=name%>64 <%= mabName %> + 0x7FFFFFFC   ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 0000111 1 | 1111111 1 | 1111111 1 | 1111111 1 | 11111 1 0 0
            <%=name%>64 <%= mabName %> + 0x80000000   ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 0001000 1 | 0000000 1 | 0000000 1 | 0000000 1 | 00000 1 0 0
            <%=name%>64 <%= mabName %> + 0xFFFF7FFC   ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 0001111 1 | 1111111 1 | 1111101 1 | 1111111 1 | 11111 1 0 0
            <%=name%>64 <%= mabName %> + 0xFFFF8000   ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 0001111 1 | 1111111 1 | 1111110 1 | 0000000 1 | 00000 1 0 0
        <% } else { %>
            <%=name%>32 <%= mabName %> + 4 * 6        ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> |          6d6 0 0
            <%=name%>32 <%= mabName %> + 4 * 63       ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> |         6d63 0 0
            <%=name%>32 <%= mabName %> + 4 * 64       ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 7d1 1 |  6d0 0 0
            <%=name%>32 <%= mabName %> + 4 * 65       ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 7d1 1 |  6d1 0 0
            <%=name%>32 <%= mabName %> + 0x7FFFFFFC   ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 0000011 1 | 1111111 1 | 1111111 1 | 1111111 1 | 111111 0 0
            <%=name%>32 <%= mabName %> + 0x80000000   ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 0000100 1 | 0000000 1 | 0000000 1 | 0000000 1 | 000000 0 0
            <%=name%>32 <%= mabName %> + 0xFFFF7FFC   ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 0000111 1 | 1111111 1 | 1111110 1 | 1111111 1 | 111111 0 0
            <%=name%>32 <%= mabName %> + 0xFFFF8000   ## RESULT 0 0 <%=flag%> 1 1 <%= mabFlags %> | 0000111 1 | 1111111 1 | 1111111 1 | 0000000 1 | 000000 0 0
        <% } %>

    <% } %>

    <% for (let [size, sizeFlag] of [[8, 0], [16, 1]]) { %>

        WRITE<%=size%> <%= mabName %>                        ## RESULT 0 0 1 1 1 <%= mabFlags %> |          5d0 <%=sizeFlag%> 1 0
        WRITE<%=size%> <%= mabName %> + <%=size%> / 8 * 1    ## RESULT 0 0 1 1 1 <%= mabFlags %> |          5d1 <%=sizeFlag%> 1 0
        WRITE<%=size%> <%= mabName %> + <%=size%> / 8 * 31   ## RESULT 0 0 1 1 1 <%= mabFlags %> |         5d31 <%=sizeFlag%> 1 0
        WRITE<%=size%> <%= mabName %> + <%=size%> / 8 * 32   ## RESULT 0 0 1 1 1 <%= mabFlags %> | 7d1 1 |  5d0 <%=sizeFlag%> 1 0
        WRITE<%=size%> <%= mabName %> + <%=size%> / 8 * 33   ## RESULT 0 0 1 1 1 <%= mabFlags %> | 7d1 1 |  5d1 <%=sizeFlag%> 1 0

        <% for (let [sign, signFlag] of [['U', 0], ['S', 1]]) { %>

            READ<%=size%><%=sign%> <%= mabName %>                        ## RESULT 0 0 0 1 1 <%= mabFlags %> |          4d0 <%=signFlag%> <%=sizeFlag%> 1 0
            READ<%=size%><%=sign%> <%= mabName %> + <%=size%> / 8 * 1    ## RESULT 0 0 0 1 1 <%= mabFlags %> |          4d1 <%=signFlag%> <%=sizeFlag%> 1 0
            READ<%=size%><%=sign%> <%= mabName %> + <%=size%> / 8 * 15   ## RESULT 0 0 0 1 1 <%= mabFlags %> |         4d15 <%=signFlag%> <%=sizeFlag%> 1 0
            READ<%=size%><%=sign%> <%= mabName %> + <%=size%> / 8 * 16   ## RESULT 0 0 0 1 1 <%= mabFlags %> | 7d1 1 |  4d0 <%=signFlag%> <%=sizeFlag%> 1 0
            READ<%=size%><%=sign%> <%= mabName %> + <%=size%> / 8 * 17   ## RESULT 0 0 0 1 1 <%= mabFlags %> | 7d1 1 |  4d1 <%=signFlag%> <%=sizeFlag%> 1 0

        <% } %>

    <% } %>

<% } %>

## GROUP_END

## GROUP Read/Write unaligned

<%

function rwMath(pop, offset) {
    offset = -BigInt(offset) & 0xFFFFFFFFn;
    if (offset >= 0x80000000n) {
        offset = -(0x100000000n - offset);
    }
    let result = '';
    if (offset >= -0x80n && offset < 0x80n) {
        result = `10 | 8d${offset & 0xFFn}`;
    } else if (offset >= -0x8000n && offset < 0x8000n) {
        result = `01 | 8d${offset & 0xFFn} | 8d${(offset >> 8n) & 0xFFn}`;
    } else {
        result = `00 | 8d${offset & 0xFFn} | 8d${(offset >> 8n) & 0xFFn} | 8d${(offset >> 16n) & 0xFFn} | 8d${(offset >> 24n) & 0xFFn}`;
    }
    if (pop) {
        return `1 5x03 ${result}`;
    } else {
        return `1 5x16 ${result}`;
    }
}

%>

READ32 1 ## RESULT <%=rwMath(false, 1)%> | 0 0 0 3d0 0 1
READ32 3 ## RESULT <%=rwMath(false, 3)%> | 0 0 0 3d0 0 1
READ32 5 ## RESULT <%=rwMath(false, 1)%> | 0 0 0 3d1 0 1
READ32 19 ## RESULT <%=rwMath(false, 3)%> | 0 0 0 3d4 0 1
READ32 21 ## RESULT <%=rwMath(false, 1)%> | 0 0 0 3d5 0 1
READ32 23 ## RESULT <%=rwMath(false, 3)%> | 0 0 0 3d5 0 1
READ32 25 ## RESULT <%=rwMath(false, 5)%> | 0 0 0 3d5 0 1
READ32 147 ## RESULT <%=rwMath(false, 127)%> | 0 0 0 3d5 0 1
READ32 149 ## RESULT <%=rwMath(false, 129)%> | 0 0 0 3d5 0 1

## GROUP_END
