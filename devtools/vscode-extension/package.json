{
	"name": "trivm-triasm-syntax-vscode",
	"displayName": "triVM Assembly",
	"description": "triVM assembly syntax highlighting",
	"version": "0.1.0",
	"preview": false,
	"icon": "logo.png",
	"engines": {
		"vscode": "^1.0.0"
	},
	"author": {
		"name": "Dominik Kilian"
	},
	"publisher": "kildom",
