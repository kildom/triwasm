{
	"scopeName": "source.asm.trivm",
	"patterns": [
		{
			"include": "#comment"
		},
		{
			"begin": "^\\s*([A-Za-z0-9_\\.\\$]+)\\s*:\\s*",
			"end": "$",
			"beginCaptures": {
				"1": {
					"name": "entity.name.function"
				}
			},
			"patterns": [
				{
					"include": "#comment"
				},
				{
					"begin": ".",
					"end": "$",
					"name": "invalid.illegal",
					"patterns": [
						{
							"include": "#comment"
						}
					]
				}
			]
		},
		{
			"begin": "^\\s*([A-Za-z0-9_\\.\\$]+)\\s*(=)\\s*",
			"end": "$",
			"beginCaptures": {
				"1": {
					"name": "variable.other"
				},
				"2": {
					"name": "keyword.operator"
				}
			},
			"patterns": [
				{
					"include": "#expression"
				}
			]
		},
		{
			"begin": "^(?i)\\s*(\\.(?:DATA|FILL)(?:8|16|32|64)|\\.(?:FILL|VMA|PMA|ALIGN|REF|LOCAL|PRAGMA|ASSERT|PLACE|BASE|EXT|BEGIN|END|IF|ELSE|ENDIF|MTABLE))(?=\\s|$|#)",
			"end": "$",
			"beginCaptures": {
				"1": {
					"name": "keyword.other"
				}
			},
			"patterns": [
				{
					"include": "#expression"
				}
			]
		},
		{
			"begin": "^(?i)\\s*([US](?:DIV|MOD|SHR|LT|GT)(?:64|64LH|64HL|64HH|64LLH|64LHL|64LHH|64HLL|64HLH|64HHL|)|(?:ADD|SUB|MUL|AND|OR|XOR|SHL|EXTS|EQ)(?:64|64LH|64HL|64HH|64LLH|64LHL|64LHH|64HLL|64HLH|64HHL|)|(?:ADD|SUB|MUL|DIV|LT|GT|LE|GE|EQ|CEIL|FLOOR|TRUNC|NEAREST|SQRT)(?:F32|F64)|U?READ(?:8S|16S|8U|16U|32|64)|U?WRITE(?:8|16|32|64)|NEG(?:64|64H|64LH|64HL|)|BR[TF]?|(?:CONVF64|CONVF32|TRUNCF64|TRUNCF32)(?:U64H|U64|S64|S64H)|(?:CONVF32|TRUNCF32|TRUNCF64)(?:U32|S32)|NOT|HOST|CALL|UNWIND|PROMOTE|DEMOTE)(?=\\s|$|#)",
			"end": "$",
			"beginCaptures": {
				"1": {
					"name": "keyword.control"
				}
			},
			"patterns": [
				{
					"include": "#expression"
				}
			]
		},
		{
			"begin": ".",
			"end": "$",
			"name": "invalid.illegal",
			"patterns": [
				{
					"include": "#comment"
				}
			]
		}
	],
	"repository": {
		"comment": {
			"patterns": [
				{
					"begin": "#",
					"end": "$",
					"name": "comment.line",
					"patterns": [
						{
							"begin": "<%",
							"end": "%>",
							"name": "string.interpolated.test.template"
						}
					]
				},
				{
					"begin": "<%",
					"end": "%>",
					"name": "string.interpolated.test.template"
				}
			]
		},
		"expression": {
			"patterns": [
				{
					"include": "#comment"
				},
				{
					"match": "-?0[Xx][0-9A-Fa-f]+",
					"name": "constant.numeric.hex"
				},
				{
					"match": "-?0[Oo][0-7]+",
					"name": "constant.numeric.oct"
				},
				{
					"match": "-?[0-9]+",
					"name": "constant.numeric.dec"
				},
				{
					"match": "GPR[0-3]|PC|ASP[LH]?|AMB[01]|SP[LH]",
					"name": "constant.language"
				},
				{
					"match": "[a-zA-Z_\\.\\$][a-zA-Z_\\.0-9]*(?=\\s*\\()",
					"name": "support.function"
				},
				{
					"match": "[a-zA-Z_\\.\\$][a-zA-Z_\\.0-9]*",
					"name": "variable.other"
				},
				{
					"match": "\\[(?:SP|AMB[01]|POP)\\]",
					"name": "variable.language"
				}
			]
		}
	}
}