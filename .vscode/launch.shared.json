{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "triasm",
            "program": "${workspaceFolder}/tools/triasm.ts",
            "args": ["-o", "out.trivm", "in.triasm"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "npm: build-triasm",
            "outFiles": [ "${workspaceFolder}/dist/bin/js/*.js" ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "triwasm",
            "program": "${workspaceFolder}/tools/wasm/triwasm.ts",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "npm: build-triwasm",
            "outFiles": [ "${workspaceFolder}/dist/bin/js/*.js" ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "triASM test vectors",
            "program": "${workspaceFolder}/test/asm/vectors.ts",
            "args": ["unwind=0, mem64=0, int64=0, float32=0, float64=0 > Read/Write"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build triASM vectors test",
            "outFiles": [ "${workspaceFolder}/test/output/asm/*.js" ]
        },
    ]
}