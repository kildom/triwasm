{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Release",
            "type": "shell",
            "command": "make -j4",
            "windows": {
                "options": {
                    "cwd": "${workspaceFolder}/build/windows"
                }
            },
            "linux": {
                "options": {
                    "cwd": "${workspaceFolder}/build/linux"
                }
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "make -j4 DEBUG=1",
            "windows": {
                "options": {
                    "cwd": "${workspaceFolder}/build/windows"
                }
            },
            "linux": {
                "options": {
                    "cwd": "${workspaceFolder}/build/linux"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build WASM",
            "type": "shell",
            "command": "make -j4 && make -j4 DEBUG=1",
            "windows": {
                "options": {
                    "cwd": "${workspaceFolder}/build/wasm",
                    "env": {
                        "WASI_SDK_ROOT": "${workspaceFolder}\\trivmlib\\build\\tools\\wasi-sdk",
                        "BINARYEN_ROOT": "${workspaceFolder}\\trivmlib\\build\\tools\\binaryen"
                    }
                }
            },
            "linux": {
                "options": {
                    "cwd": "${workspaceFolder}/build/wasm",
                    "env": {
                        "WASI_SDK_ROOT": "${workspaceFolder}/trivmlib/build/tools/wasi-sdk",
                        "BINARYEN_ROOT": "${workspaceFolder}/trivmlib/build/tools/binaryen"
                    }
                }
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}